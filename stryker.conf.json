{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.mutation.config.ts"
  },
  "reporters": ["html", "json", "clear-text", "progress"],
  "coverageAnalysis": "perTest",
  "concurrency": 5,
  "incremental": true,
  "ignoreStatic": true,
  "timeoutMS": 20000,
  "mutate": [
    "app/lib/**/*.ts",
    "app/domain/**/*.ts",
    "app/ui/components/nabu/*.ts",
    "app/ui/hooks/*.ts",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.fixture.ts",
    "!**/*.stories.ts",
    "!**/*.stories.tsx"
  ],
  "disableBail": true,
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  }
}
